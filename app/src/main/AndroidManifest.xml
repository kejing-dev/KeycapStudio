<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No camera, microphone, location or network. Exports use MediaStore (no storage permission). -->
    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeycapStudio"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.KeycapStudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Default container: the Shared Space volume holding the 1:1 keyboard (design container.windows.studio) -->
            <meta-data android:name="pico.spatial.windowcontainer.id" android:value="Studio" />
            <!-- "2": Form.Volumetric -->
            <meta-data android:name="pico.spatial.windowcontainer.style" android:value="2" />
            <!-- width x height x depth, metres -->
            <meta-data android:name="pico.spatial.windowcontainer.defaultsize" android:value="0.8x0.5x0.8" />
            <meta-data android:name="pico.spatial.windowcontainer.defaultsize.unit" android:value="meters" />
            <meta-data android:name="pico.spatial.windowcontainer.resizetype" android:value="0" />
            <!-- "1": uniform resize only -->
            <meta-data android:name="pico.spatial.windowcontainer.resizerestriction" android:value="1" />
            <!-- "2": WorldScale.Fixed, the keyboard stays 1:1 at any distance -->
            <meta-data android:name="pico.spatial.windowcontainer.worldscaletype" android:value="2" />
            <meta-data android:name="pico.spatial.windowcontainer.captionbar" android:value="0" />
            <!-- "0": no material background behind the keyboard -->
            <meta-data android:name="pico.spatial.windowcontainer.materialbackground" android:value="0" />
            <!-- "0": VolumeAlignment.Gravity -->
            <meta-data android:name="pico.spatial.windowcontainer.volumealignment" android:value="0" />
            <meta-data android:name="pico.spatial.windowcontainer.volumebasepanel" android:value="0" />
        </activity>
    </application>

</manifest>
